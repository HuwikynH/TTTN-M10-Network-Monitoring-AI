# Backend
POST_TO_BACKEND=true
BACKEND_API_URL=http://127.0.0.1:8000/api/v1
BACKEND_TIMEOUT_SECONDS=10

# Collection identity and default dataset metadata
LAB_SOURCE=huynh_lab
DATASET_LABEL=normal
DATASET_SCENARIO=baseline
DATASET_OUTPUT=network_dataset.json

# Collection timing and SNMP load
COLLECTOR_INTERVAL_SECONDS=1
TRAFFIC_SAMPLE_DELAY=1
SNMP_CONCURRENCY=4

# Metric handling and console output
POSITIVE_METRIC_MODE=off
RAW_SNMP_DEBUG=false
PRINT_DEVICE_SUMMARY=true
VERBOSE_PROGRESS=false
DEMO_NORMALIZE_CPU=false
