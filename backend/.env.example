# Local backend configuration
APP_NAME=TTTN M10 Network Monitoring AI
APP_ENV=development
DATABASE_URL=sqlite:///./network_monitoring.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEVICE_STALE_SECONDS=45
AI_MODEL_PATH=../ai/models/scenario_random_forest.joblib

# Telegram notifications (keep secrets only in backend/.env)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=5
TELEGRAM_NOTIFY_RECOVERY=true
# Use a LAN/public URL reachable from the phone, not 127.0.0.1.
TELEGRAM_DASHBOARD_URL=

# PostgreSQL example (used instead of SQLite when needed)
# DATABASE_URL=postgresql+psycopg://monitoring:monitoring@localhost:5432/network_monitoring
